# ---- Database (AWS RDS MySQL endpoint from `terraform output rds_endpoint`) ----
DB_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=interview_admin
DB_PASSWORD=change-me
DB_NAME=interview_db
# Path inside the container to the RDS CA bundle (baked into the image). Leave empty for local MySQL.
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem
# Or give a full URL instead (used for local/SQLite): DATABASE_URL=sqlite:///./local.db

# ---- LLM ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# auto = use OpenAI if key present, else offline heuristic mode | openai | mock
LLM_MODE=auto

# ---- App ----
ADMIN_API_KEY=change-me-recruiter-key
DEFAULT_NUM_QUESTIONS=5
ANSWER_TIMEOUT_SECONDS=900
